%% 部署视图：GCP 服务、location、身份
%% 用真实 GCP 图标渲染，需要 iconify 的 gcp 图标包（214 个图标）。
%% GitHub 的 Markdown 渲染器无法注册图标包，所以这份要预渲染成 SVG 提交。
%% 重新生成：tools/render_diagrams.sh
%%
%% architecture-beta 没有边标签语法，所以身份写在节点标签里，
%% 具体授权（READER / WRITER / run.invoker）见 README 的表。
architecture-beta
    group r1(cloud)[Region us central1 all compute]
        service gke(gcp:google-kubernetes-engine)[GKE tpu training antgroup 122 nodes 488 chips] in r1
        service ar(gcp:artifact-registry)[Artifact Registry mlobs] in r1
        service sch(gcp:cloud-scheduler)[Cloud Scheduler every 30 min SA mlobs scheduler] in r1
        service job(gcp:cloud-run)[Cloud Run job mlobs refresh SA mlobs refresh] in r1
        service svc(gcp:cloud-run)[Cloud Run svc mlobs grafana private SA mlobs grafana] in r1
    group gl(cloud)[Global observability]
        service lg(gcp:cloud-logging)[Cloud Logging Default 30 days Log Analytics on] in gl
        service mon(gcp:cloud-monitoring)[Cloud Monitoring] in gl
    group us(cloud)[BigQuery US multi region all data and modelling]
        service raw(gcp:bigquery)[mlobs raw L1 physical billing] in us
        service core(gcp:bigquery)[mlobs core L2 L3 modelling in pure SQL] in us

    sch:R --> L:job
    ar:B --> T:job
    ar:R --> L:svc
    gke:L --> R:lg
    job:B --> T:raw
    raw:R --> L:core
    svc:B --> T:core
    svc:L --> R:mon
